LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

HUGGING_FACE_TOKEN=
# Optional (defaults shown)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aura-dev-password
QDRANT_URL=http://localhost:6333
VOID_URL=http://localhost:4000
DATABASE_URL=postgres://void:void@localhost:5433/void
# Leave empty: the agent generates one into .aura_state/api_token. Set it only for a remote agent.
AURA_API_TOKEN=

# Where the watched service runs: docker (local demo) or kubernetes (uses kubectl:
# KUBECONFIG / ~/.kube/config when outside the cluster, the ServiceAccount when inside)
AURA_RUNTIME=docker
K8S_NAMESPACE=default
K8S_CONTEXT=
K8S_APP_DEPLOYMENT=   # empty = auto-detect (`uv run aura connect -n <ns>` shows and saves it)
K8S_APP_SELECTOR=
K8S_DB_STATEFULSET=
